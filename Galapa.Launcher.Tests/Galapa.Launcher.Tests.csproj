<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.17763</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.4"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="Moq" Version="4.20.72"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Galapa.Launcher\Galapa.Launcher.csproj"/>
        <ProjectReference Include="..\Galapa.TestUtilities\Galapa.TestUtilities.csproj"/>
    </ItemGroup>

    <!-- AvaloniaUI.DiagnosticsSupport 2.2.3 ships its DLL twice (lib/net10.0 for Avalonia 12,
         lib/net10.0/v11 for Avalonia 11). The transitive copy flows in from Galapa.Launcher and
         collides during this project's MSIX payload generation (APPX1101). Drop the non-v11 copy —
         the same de-dup Galapa.Launcher.csproj already applies to itself. -->
    <Target Name="RemoveDuplicateDiagnosticsSupport" AfterTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(FullPath)').Contains('net10.0\AvaloniaUI.DiagnosticsSupport')) AND !$([System.String]::Copy('%(FullPath)').Contains('v11'))" />
        </ItemGroup>
    </Target>

</Project>