<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Must match the 32-bit game process: kernel32 base parity (for the
             LoadLibraryW address) and 32-bit pointer width both require x86. -->
        <PlatformTarget>x86</PlatformTarget>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Talon.Injector</RootNamespace>
        <AssemblyName>Talon.Injector</AssemblyName>
    </PropertyGroup>

    <!-- Galapa.sln declares Talon.Boot as this project's build dependency. Copy in a
         target (rather than an evaluation-time Exists-conditioned Content item) so a
         clean full MSBuild sees the DLL produced earlier in the same solution build.
         Galapa.slnf intentionally excludes the native project; CI builds it explicitly. -->
    <Target Name="CopyTalonBootPayload" AfterTargets="Build"
            Condition="Exists('..\Talon.Boot\bin\x86\$(Configuration)\Talon.Boot.dll')">
        <Copy SourceFiles="..\Talon.Boot\bin\x86\$(Configuration)\Talon.Boot.dll"
              DestinationFolder="$(OutDir)"
              SkipUnchangedFiles="true"/>
    </Target>

</Project>
