<Project Sdk="Microsoft.NET.Sdk"
         TreatAsLocalProperty="RuntimeIdentifier;SelfContained">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Must match the 32-bit game process: kernel32 base parity (for the
             LoadLibraryW address) and 32-bit pointer width both require x86. -->
        <PlatformTarget>x86</PlatformTarget>
        <RuntimeIdentifier>win-x86</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Talon.Injector</RootNamespace>
        <AssemblyName>Talon.Injector</AssemblyName>
        <TalonRequireNativePayload Condition="'$(TalonRequireNativePayload)' == ''">false</TalonRequireNativePayload>
    </PropertyGroup>

    <!-- Galapa.sln declares Talon.Boot as this project's build dependency. Copy in a
         target (rather than an evaluation-time Exists-conditioned Content item) so a
         clean full MSBuild sees the DLL produced earlier in the same solution build.
         Galapa.slnf intentionally excludes the native project; CI builds it explicitly. -->
    <ItemGroup>
        <!-- Injector owns the single self-contained runtime. Talon is a normal
             managed dependency loaded into that runtime inside DQX. -->
        <ProjectReference Include="..\Talon\Talon.csproj" />
        <Content Include="..\LICENSE" Link="LICENSE"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="CopyTalonBootPayload" AfterTargets="Build"
            Condition="Exists('..\Talon.Boot\bin\x86\$(Configuration)\Talon.Boot.dll')">
        <Copy SourceFiles="..\Talon.Boot\bin\x86\$(Configuration)\Talon.Boot.dll"
              DestinationFolder="$(OutDir)"
              SkipUnchangedFiles="true"/>
    </Target>

    <!-- Self-contained publish does not copy the runtime pack's legal files.
         Preserve the exact notices that accompany the selected x86 runtime. -->
    <Target Name="CopyDotNetRuntimeNotices" AfterTargets="Build"
            DependsOnTargets="ResolveFrameworkReferences">
        <ItemGroup>
            <TalonDotNetRuntimeNotice
                Include="@(ResolvedRuntimePack->'%(PackageDirectory)\LICENSE.TXT')"
                Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App' and Exists('%(ResolvedRuntimePack.PackageDirectory)\LICENSE.TXT')" />
            <TalonDotNetRuntimeNotice
                Include="@(ResolvedRuntimePack->'%(PackageDirectory)\THIRD-PARTY-NOTICES.TXT')"
                Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App' and Exists('%(ResolvedRuntimePack.PackageDirectory)\THIRD-PARTY-NOTICES.TXT')" />
        </ItemGroup>
        <Copy SourceFiles="@(TalonDotNetRuntimeNotice)"
              DestinationFiles="@(TalonDotNetRuntimeNotice->'$(OutDir)licenses\dotnet-runtime\%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="ValidateTalonBuildPayload" AfterTargets="Build"
            DependsOnTargets="CopyTalonBootPayload;CopyDotNetRuntimeNotices">
        <Warning Condition="!Exists('$(OutDir)Talon.Boot.dll') and '$(TalonRequireNativePayload)' != 'true'"
                 Text="Talon.Boot.dll is missing. The managed-only injector output cannot launch DQX." />
        <Error Condition="!Exists('$(OutDir)Talon.Boot.dll') and '$(TalonRequireNativePayload)' == 'true'"
               Text="Talon.Boot.dll is missing. Build Talon.Boot Win32 $(Configuration) before Talon.Injector." />
        <Error Condition="!Exists('$(OutDir)Talon.dll')"
               Text="Talon.dll is missing from the Injector output." />
        <Error Condition="!Exists('$(OutDir)goatcorp.Reloaded.Hooks.dll')"
               Text="goatcorp.Reloaded.Hooks.dll is missing from the Injector output." />
        <Error Condition="!Exists('$(OutDir)Microsoft.Data.Sqlite.dll') or !Exists('$(OutDir)SQLitePCLRaw.batteries_v2.dll') or !Exists('$(OutDir)SQLitePCLRaw.core.dll') or !Exists('$(OutDir)SQLitePCLRaw.provider.e_sqlite3.dll') or !Exists('$(OutDir)e_sqlite3.dll')"
               Text="The SQLite path-catalog payload is incomplete." />
        <Error Condition="!Exists('$(OutDir)licenses\Microsoft.Data.Sqlite.MIT.txt') or !Exists('$(OutDir)licenses\SQLitePCLRaw.Apache-2.0.txt') or !Exists('$(OutDir)licenses\SQLite.Public-Domain.txt')"
               Text="The SQLite path-catalog license notices are missing." />
        <Error Condition="!Exists('$(OutDir)licenses\dotnet-runtime\LICENSE.TXT') or !Exists('$(OutDir)licenses\dotnet-runtime\THIRD-PARTY-NOTICES.TXT')"
               Text="The .NET runtime license notices are missing from the Injector output." />
    </Target>

    <Target Name="RequireTalonPayloadForPublish" BeforeTargets="Publish"
            DependsOnTargets="ValidateTalonBuildPayload">
        <Error Condition="!Exists('$(OutDir)Talon.Boot.dll')"
               Text="Talon.Boot.dll is missing. Build Talon.Boot Win32 $(Configuration) before publishing Talon.Injector." />
        <Error Condition="!Exists('$(OutDir)Talon.dll') or !Exists('$(OutDir)goatcorp.Reloaded.Hooks.dll')"
               Text="The managed Talon payload is incomplete; refusing to publish." />
    </Target>

    <!-- Build output is assembled after normal SDK item resolution, so explicitly
         copy the Talon payload into the final publish directory as well. -->
    <Target Name="PublishTalonPayload" AfterTargets="Publish"
            DependsOnTargets="RequireTalonPayloadForPublish">
        <ItemGroup>
            <TalonRuntimeNotice Include="$(OutDir)licenses\dotnet-runtime\*" />
        </ItemGroup>
        <Copy SourceFiles="$(OutDir)Talon.Boot.dll"
              DestinationFolder="$(PublishDir)"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(TalonRuntimeNotice)"
              DestinationFolder="$(PublishDir)licenses\dotnet-runtime"
              SkipUnchangedFiles="true" />
        <Error Condition="!Exists('$(PublishDir)Talon.dll') or !Exists('$(PublishDir)goatcorp.Reloaded.Hooks.dll') or !Exists('$(PublishDir)Talon.Boot.dll')"
               Text="The published Talon payload is incomplete." />
        <Error Condition="!Exists('$(PublishDir)Microsoft.Data.Sqlite.dll') or !Exists('$(PublishDir)SQLitePCLRaw.batteries_v2.dll') or !Exists('$(PublishDir)SQLitePCLRaw.core.dll') or !Exists('$(PublishDir)SQLitePCLRaw.provider.e_sqlite3.dll') or !Exists('$(PublishDir)e_sqlite3.dll')"
               Text="The published SQLite path-catalog payload is incomplete." />
        <Error Condition="!Exists('$(PublishDir)licenses\Microsoft.Data.Sqlite.MIT.txt') or !Exists('$(PublishDir)licenses\SQLitePCLRaw.Apache-2.0.txt') or !Exists('$(PublishDir)licenses\SQLite.Public-Domain.txt')"
               Text="The published SQLite path-catalog license notices are missing." />
        <Error Condition="!Exists('$(PublishDir)licenses\dotnet-runtime\LICENSE.TXT') or !Exists('$(PublishDir)licenses\dotnet-runtime\THIRD-PARTY-NOTICES.TXT')"
               Text="The published .NET runtime license notices are incomplete." />
    </Target>

</Project>
