<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Must match the 32-bit game process: kernel32 base parity (for the
             LoadLibraryW address) and 32-bit pointer width both require x86. -->
        <PlatformTarget>x86</PlatformTarget>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Talon.Injector</RootNamespace>
        <AssemblyName>Talon.Injector</AssemblyName>
    </PropertyGroup>

    <!-- The native boot DLL is consumed as a build output copied next to the
         injector exe, NOT as a ProjectReference: a .NET SDK project cannot build
         or reference a C++ .vcxproj across the SDK/VC toolchain divide. Build
         Talon.Boot separately (msbuild) before/alongside this project. -->
    <ItemGroup>
        <Content Include="..\Talon.Boot\bin\x86\$(Configuration)\Talon.Boot.dll"
                 Condition="Exists('..\Talon.Boot\bin\x86\$(Configuration)\Talon.Boot.dll')">
            <Link>Talon.Boot.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
