<Project Sdk="Microsoft.NET.Sdk"
         TreatAsLocalProperty="RuntimeIdentifier;SelfContained">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <RootNamespace>Talon</RootNamespace>
    <AssemblyName>Talon</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="goatcorp.Reloaded.Hooks" Version="4.2.0-goatcorp8" />
    <PackageReference Include="MinSharp" Version="1.0.4" />
  </ItemGroup>

  <Target Name="CopyTalonNetHost"
          BeforeTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="ResolveFrameworkReferences">
    <ItemGroup>
      <TalonAppHostPack Include="@(KnownAppHostPack)"
                        Condition="'%(KnownAppHostPack.TargetFramework)' == 'net$(_TargetFrameworkVersionWithoutV)'" />
      <TalonNetHost Include="@(TalonAppHostPack->'$(NetCoreTargetingPackRoot)\Microsoft.NETCore.App.Host.$(RuntimeIdentifier)\%(AppHostPackVersion)\runtimes\$(RuntimeIdentifier)\native\nethost.dll')" />
    </ItemGroup>
    <Error Condition="'@(TalonAppHostPack)' == ''"
           Text="The active .NET SDK does not define an app-host pack for $(TargetFramework)." />
    <Error Condition="'@(TalonNetHost)' == ''"
           Text="The Talon nethost path could not be resolved for $(RuntimeIdentifier)." />
    <Error Condition="'@(TalonNetHost)' != '' and !Exists('%(TalonNetHost.Identity)')"
           Text="The resolved Talon nethost file does not exist: %(TalonNetHost.Identity)" />
    <Copy SourceFiles="@(TalonNetHost)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
