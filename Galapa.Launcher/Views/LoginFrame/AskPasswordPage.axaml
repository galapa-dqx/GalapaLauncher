<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Galapa.Launcher.ViewModels.LoginFrame"
             xmlns:ui="using:Galapa.UI.Controls"
             xmlns:local="using:Galapa.Launcher.Views.Controls"
             x:DataType="vm:AskPasswordPageViewModel"
             x:Class="Galapa.Launcher.Views.LoginFrame.AskPasswordPage">
    <StackPanel Spacing="19" Margin="0,7,0,0">
        <local:ThemedField Label="Username" Text="{Binding Username}" IsReadOnly="True" />
        <local:ThemedField Label="Password" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●"
                           AutomationProperties.Name="Password" />
        <CheckBox Content="Save password" IsChecked="{Binding FlowState.SavePassword, Mode=TwoWay}"
                  HorizontalAlignment="Center" FontSize="12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
            <local:ThemedSvg InlineSvg="{DynamicResource Galapa.Image.play-ornament}"
                             FallbackInlineSvg="{x:Static local:ThemeGlyphs.Flourish}"
                             CurrentColor="{DynamicResource Galapa.Part.play-row.ContentBrush}"
                             Width="35" Height="20" />
            <Button Classes="themed" Width="75" Height="31" Command="{Binding LoginCommand}">
                <ui:ThemedTextBlock SourceText="Play"
                                    FontFamily="{DynamicResource Galapa.Type.Control.button.Family}"
                                    FontSize="{DynamicResource Galapa.Type.Control.button.Size}"
                                    FontWeight="{DynamicResource Galapa.Type.Control.button.Weight}"
                                    ui:ThemedTextBlock.TextTransform="{DynamicResource Galapa.Type.Control.button.Transform}" />
            </Button>
            <local:ThemedSvg InlineSvg="{DynamicResource Galapa.Image.play-ornament}"
                             FallbackInlineSvg="{x:Static local:ThemeGlyphs.Flourish}"
                             CurrentColor="{DynamicResource Galapa.Part.play-row.ContentBrush}"
                             Width="35" Height="20" RenderTransform="scaleX(-1)" />
        </StackPanel>
    </StackPanel>
</UserControl>
