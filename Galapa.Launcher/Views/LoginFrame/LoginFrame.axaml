<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Galapa.Launcher.ViewModels.LoginFrame"
             xmlns:conv="using:Galapa.Launcher.Converters"
             x:Class="Galapa.Launcher.Views.LoginFrame.LoginFrame"
             x:DataType="vm:LoginFrameViewModel">
    <Grid RowDefinitions="Auto,*">
        <TransitioningContentControl Content="{Binding CanReturnToPlayerSelect, Converter={StaticResource BoolToObjectOrNull}}">
            <TransitioningContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type conv:ShowObject}">
                    <Button Classes="themed label" HorizontalAlignment="Left"
                            Command="{Binding $parent[UserControl].DataContext.ReturnToPlayerSelectCommand}"
                            Content="← Players" AutomationProperties.Name="Back to player selection" />
                </DataTemplate>
            </TransitioningContentControl.ContentTemplate>
        </TransitioningContentControl>
        <TransitioningContentControl Grid.Row="1" Margin="0,8,0,0" Content="{Binding Page}" IsTransitionReversed="{Binding IsTransitionReversed}">
            <TransitioningContentControl.PageTransition>
                <PageSlide Duration="0:00:00.200" Orientation="Horizontal" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </Grid>
</UserControl>
