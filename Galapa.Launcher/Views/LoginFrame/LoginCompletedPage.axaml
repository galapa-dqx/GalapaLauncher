<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Galapa.Launcher.ViewModels.LoginFrame" x:DataType="vm:LoginCompletedPageViewModel"
             x:Class="Galapa.Launcher.Views.LoginFrame.LoginCompletedPage">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Border Width="52" Height="52" CornerRadius="99" Background="{DynamicResource Galapa.Brush.Success}"><TextBlock Text="✓" Foreground="White" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Launching game…" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Width="150" />
    </StackPanel>
</UserControl>
