<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Galapa.Launcher.ViewModels.LoginFrame"
             xmlns:local="using:Galapa.Launcher.Views.Controls"
             x:DataType="vm:AskUsernamePasswordPageViewModel"
             x:Class="Galapa.Launcher.Views.LoginFrame.AskUsernamePasswordPage">
    <StackPanel Spacing="19" Margin="0,7,0,0">
        <local:ThemedField Label="Username" Text="{Binding Username, Mode=TwoWay}"
                           AutomationProperties.Name="Username" />
        <local:ThemedField Label="Password" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●"
                           AutomationProperties.Name="Password" />
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <CheckBox Content="Save username" IsChecked="{Binding FlowState.SaveUser, Mode=TwoWay}" FontSize="12" />
            <CheckBox Content="Save password" IsChecked="{Binding FlowState.SavePassword, Mode=TwoWay}"
                      IsEnabled="{Binding FlowState.SaveUser}" FontSize="12" />
        </StackPanel>
        <local:PlayRow Content="Play" Command="{Binding LoginCommand}" />
    </StackPanel>
</UserControl>
