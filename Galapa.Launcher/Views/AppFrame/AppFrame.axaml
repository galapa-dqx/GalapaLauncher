<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Galapa.Launcher.ViewModels.AppFrame"
             x:Class="Galapa.Launcher.Views.AppFrame.AppFrame"
             x:DataType="vm:AppFrameViewModel">
    <Grid>
        <TransitioningContentControl Content="{Binding SelectedPage.ViewModel.Value}"
                                     IsVisible="{Binding !IsOnboarding}" />
        <ContentControl Content="{Binding Onboarding}" IsVisible="{Binding IsOnboarding}" />
    </Grid>
</UserControl>
