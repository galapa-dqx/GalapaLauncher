<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Galapa.Launcher.Views.Controls"
             x:Class="Galapa.Launcher.Views.Controls.ThemedScrollbar"
             Width="8">
    <Grid Name="PART_Track" Background="Transparent">
        <local:ThemePart PartStyle="{DynamicResource Galapa.Part.scrollbar.track}" IsHitTestVisible="False" />
        <Canvas>
            <local:ThemePart Name="PART_Thumb" Width="8" MinHeight="12"
                             PartStyle="{DynamicResource Galapa.Part.scrollbar.thumb}" />
        </Canvas>
    </Grid>
</UserControl>
