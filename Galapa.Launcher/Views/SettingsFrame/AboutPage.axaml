<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Galapa.Launcher.ViewModels.SettingsFrame"
             xmlns:ui="using:Galapa.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             x:Class="Galapa.Launcher.Views.SettingsFrame.AboutPage"
             x:DataType="vm:AboutPageViewModel">

    <Design.DataContext>
        <vm:AboutPageViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <!-- Icon path data (Material Design Icons) -->
        <StreamGeometry x:Key="IconInfo">M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z</StreamGeometry>
        <StreamGeometry x:Key="IconGlobe">M16.36,14C16.44,13.34 16.5,12.68 16.5,12C16.5,11.32 16.44,10.66 16.36,10H19.74C19.9,10.64 20,11.31 20,12C20,12.69 19.9,13.36 19.74,14M14.59,19.56C15.19,18.45 15.65,17.25 15.97,16H18.92C17.96,17.65 16.43,18.93 14.59,19.56M14.34,14H9.66C9.56,13.34 9.5,12.68 9.5,12C9.5,11.32 9.56,10.65 9.66,10H14.34C14.43,10.65 14.5,11.32 14.5,12C14.5,12.68 14.43,13.34 14.34,14M12,19.96C11.17,18.76 10.5,17.43 10.09,16H13.91C13.5,17.43 12.83,18.76 12,19.96M8,8H5.08C6.03,6.34 7.57,5.06 9.4,4.44C8.8,5.55 8.35,6.75 8,8M5.08,16H8C8.35,17.25 8.8,18.45 9.4,19.56C7.57,18.93 6.03,17.65 5.08,16M4.26,14C4.1,13.36 4,12.69 4,12C4,11.31 4.1,10.64 4.26,10H7.64C7.56,10.66 7.5,11.32 7.5,12C7.5,12.68 7.56,13.34 7.64,14M12,4.03C12.83,5.23 13.5,6.57 13.91,8H10.09C10.5,6.57 11.17,5.23 12,4.03M18.92,8H15.97C15.65,6.75 15.19,5.55 14.59,4.44C16.43,5.07 17.96,6.34 18.92,8M12,2C6.47,2 2,6.5 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
        <StreamGeometry x:Key="IconLibraries">M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.7,1.7L9,6L6,9L1.6,4.7C0.4,7.1 0.9,10.1 2.9,12.1C4.8,14 7.5,14.5 9.8,13.6L18.9,22.7C19.3,23.1 19.9,23.1 20.3,22.7L22.6,20.4C23.1,20 23.1,19.3 22.7,19Z</StreamGeometry>
        <StreamGeometry x:Key="IconExternalLink">M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z</StreamGeometry>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Spacing="8" Margin="20" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="About" FontSize="24" FontWeight="Bold" Margin="0,0,0,16" />

            <!-- Version -->
            <ui:SettingsCard Header="GalapaLauncher" Description="{Binding VersionDisplay}">
                <ui:SettingsCard.Icon>
                    <PathIcon Data="{StaticResource IconInfo}" Width="20" Height="20" />
                </ui:SettingsCard.Icon>
                <ui:SettingsCard.ActionContent>
                    <Button Content="Copy" Click="OnCopyVersionClick" />
                </ui:SettingsCard.ActionContent>
            </ui:SettingsCard>

            <!-- Help and support -->
            <TextBlock Text="Help and support" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" />

            <ui:SettingsCard Header="GitHub repository"
                             IsClickEnabled="True"
                             Command="{Binding OpenUrlCommand}"
                             CommandParameter="{x:Static vm:AboutPageViewModel.RepositoryUrl}">
                <ui:SettingsCard.Icon>
                    <PathIcon Data="{StaticResource IconGlobe}" Width="20" Height="20" />
                </ui:SettingsCard.Icon>
                <ui:SettingsCard.ActionContent>
                    <PathIcon Data="{StaticResource IconExternalLink}" Width="16" Height="16" Opacity="0.6" />
                </ui:SettingsCard.ActionContent>
            </ui:SettingsCard>

            <ui:SettingsCard Header="Open data folder"
                             Description="View logs and configuration files"
                             IsClickEnabled="True"
                             Command="{Binding OpenLogLocationCommand}">
                <ui:SettingsCard.Icon>
                    <PathIcon Data="{StaticResource IconFolder}" Width="20" Height="20" />
                </ui:SettingsCard.Icon>
                <ui:SettingsCard.ActionContent>
                    <PathIcon Data="{StaticResource IconExternalLink}" Width="16" Height="16" Opacity="0.6" />
                </ui:SettingsCard.ActionContent>
            </ui:SettingsCard>

            <!-- Open source -->
            <TextBlock Text="Open source" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" />

            <ui:SettingsExpander Header="Third party libraries"
                                 Description="Open source libraries that make GalapaLauncher possible">
                <ui:SettingsExpander.Icon>
                    <PathIcon Data="{StaticResource IconLibraries}" Width="20" Height="20" />
                </ui:SettingsExpander.Icon>
                <ui:SettingsExpander.ExpanderContent>
                    <ItemsControl ItemsSource="{Binding Libraries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryInfo">
                                <Button Content="{Binding Name}"
                                        Width="220"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Command="{Binding $parent[ItemsControl].((vm:AboutPageViewModel)DataContext).OpenUrlCommand}"
                                        CommandParameter="{Binding Url}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:SettingsExpander.ExpanderContent>
            </ui:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
