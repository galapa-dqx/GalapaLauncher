<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Galapa.Launcher.ViewModels.SettingsFrame" xmlns:ui="using:Galapa.UI.Controls"
             xmlns:local="using:Galapa.Launcher.Views.Controls"
             x:Class="Galapa.Launcher.Views.SettingsFrame.GameSettingsPage" x:DataType="vm:GameSettingsPageViewModel">
    <local:SettingsPageShell>
        <StackPanel Spacing="10">
            <ui:ThemedTextBlock Classes="section" SourceText="Folders" Margin="0,0,0,1" />
            <local:ThemedField Label="Dragon Quest X folder" Text="{Binding Settings.GameFolderPath}"
                               AutomationProperties.Name="Dragon Quest X folder" />
            <local:ThemedField Label="Save and configuration folder" Text="{Binding Settings.SaveFolderPath}"
                               AutomationProperties.Name="Save and configuration folder" />
            <Button Classes="themed label" Height="43" HorizontalAlignment="Stretch"
                    Content="Save folders" Command="{Binding SaveCommand}" />
        </StackPanel>
        <local:SettingsPageShell.HelpContent>
            <StackPanel Spacing="10">
                <ui:ThemedTextBlock Classes="section" SourceText="Game folders" />
                <TextBlock TextWrapping="Wrap"
                           Text="Choose the Dragon Quest X installation and the folder Galapa uses for game configuration and local data." />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="The install folder must contain Game\DQXGame.exe." />
            </StackPanel>
        </local:SettingsPageShell.HelpContent>
    </local:SettingsPageShell>
</UserControl>
