<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Galapa.Launcher.ViewModels.SettingsFrame"
             xmlns:editing="using:Galapa.Launcher.ViewModels.Editing"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             x:Class="Galapa.Launcher.Views.SettingsFrame.GameSettingsPage"
             x:DataType="vm:GameSettingsPageViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="10">
            <TextBlock Text="Game Settings" FontSize="24" FontWeight="Bold" />

            <!-- Changes apply as soon as they are valid; there is no Save button. -->
            <StackPanel Spacing="6" DataContext="{Binding InstallFolder}" x:DataType="editing:InstallFolderEditor">
                <TextBlock Text="Game folder" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Help}" TextWrapping="Wrap" Opacity="0.7" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding Field.Draft, Mode=TwoWay}"
                             Watermark="C:\Program Files (x86)\SquareEnix\DRAGON QUEST X" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
                </Grid>

                <TextBlock Text="Checking…" Opacity="0.7" IsVisible="{Binding Field.IsValidating}" />
                <TextBlock Text="Saving…" Opacity="0.7" IsVisible="{Binding Field.IsSaving}" />
                <TextBlock Text="{Binding Field.Error}"
                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Field.HasError}" />
                <TextBlock Text="{Binding ExecutablePath, StringFormat='Launches {0}'}"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ExecutablePath, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
