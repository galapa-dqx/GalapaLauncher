<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Galapa.Launcher.ViewModels.SettingsFrame" xmlns:ui="using:Galapa.UI.Controls"
             xmlns:local="using:Galapa.Launcher.Views.Controls"
             x:Class="Galapa.Launcher.Views.SettingsFrame.GameSettingsPage" x:DataType="vm:GameSettingsPageViewModel">
    <Grid Margin="34,26,34,34" ColumnDefinitions="*,35,280">
        <ScrollViewer Name="GameScroll" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="10">
                <ui:ThemedTextBlock Classes="section" SourceText="Folders" Margin="0,0,0,1" />
                <StackPanel Spacing="4">
                    <ui:ThemedTextBlock Classes="field-label" SourceText="Dragon Quest X folder" />
                    <TextBox Height="43" Padding="12,0" VerticalContentAlignment="Center"
                             Text="{Binding Settings.GameFolderPath}" AutomationProperties.Name="Dragon Quest X folder" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <ui:ThemedTextBlock Classes="field-label" SourceText="Save and configuration folder" />
                    <TextBox Height="43" Padding="12,0" VerticalContentAlignment="Center"
                             Text="{Binding Settings.SaveFolderPath}" AutomationProperties.Name="Save and configuration folder" />
                </StackPanel>
                <Button Classes="themed primary" Height="43" HorizontalAlignment="Stretch"
                        Command="{Binding SaveCommand}">
                    <ui:ThemedTextBlock SourceText="Save folders"
                                        FontFamily="{DynamicResource Galapa.Type.Control.button.Family}"
                                        FontSize="{DynamicResource Galapa.Type.Control.button.Size}"
                                        FontWeight="{DynamicResource Galapa.Type.Control.button.Weight}"
                                        FontStyle="{DynamicResource Galapa.Type.Control.button.Style}"
                                        ui:ThemedTextBlock.TextTransform="{DynamicResource Galapa.Type.Control.button.Transform}" />
                </Button>
            </StackPanel>
        </ScrollViewer>

        <local:ThemedScrollbar Grid.Column="1" HorizontalAlignment="Center" Target="{Binding #GameScroll}" />

        <Border Grid.Column="2" Classes="panel" Padding="15">
            <StackPanel Spacing="10">
                <ui:ThemedTextBlock Classes="section" SourceText="Game folders" />
                <TextBlock TextWrapping="Wrap"
                           Text="Choose the Dragon Quest X installation and the folder Galapa uses for game configuration and local data." />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="The install folder must contain Game\DQXGame.exe." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
