{
  "label": "Maille",
  "mode": "light",
  "focusRing": {
    "color": "#b05870",
    "width": 2,
    "offset": -2
  },
  "controls": {
    "window": {
      "shape": "Window",
      "fill": "#fdf0f2",
      "content": "#2a1018",
      "borderColor": "#dcc8cc"
    },
    "panel": {
      "shape": "Path",
      "fill": "#fff5f7",
      "borderColor": "#dcc8cc",
      "borderThickness": 1
    },
    "button": {
      "shape": "Path",
      "fill": "#b05870",
      "content": "#fff5f7",
      "radius": "pill",
      "padding": [
        6,
        20,
        6,
        20
      ],
      "text": {
        "family": "Crimson Pro",
        "fallback": "serif",
        "weight": 700,
        "style": "normal",
        "size": 16,
        "case": "uppercase"
      },
      "states": {
        "hover": {
          "fill": "#bb6c80"
        },
        "pressed": {
          "fill": "#94495d"
        },
        "disabled": {
          "opacity": 0.5
        }
      }
    },
    "input": {
      "shape": "Path",
      "content": "#2a1018",
      "borderColor": "#dcc8cc",
      "borderThickness": 1,
      "padding": [
        6,
        10,
        6,
        10
      ],
      "text": {
        "family": "Source Sans 3",
        "fallback": "sans-serif",
        "weight": 400,
        "style": "normal",
        "size": 16
      },
      "states": {
        "focused": {
          "borderColor": "#b05870",
          "borderThickness": 2
        },
        "disabled": {
          "opacity": 0.5
        }
      }
    },
    "tab": {
      "shape": "Path",
      "content": "#8a5868",
      "borderColor": "transparent",
      "borderThickness": [
        0,
        0,
        2,
        0
      ],
      "padding": [
        0,
        10,
        0,
        10
      ],
      "text": {
        "family": "Crimson Pro",
        "fallback": "serif",
        "weight": 700,
        "style": "normal",
        "case": "uppercase"
      },
      "states": {
        "hover": {
          "content": "#b05870"
        },
        "selected": {
          "content": "#b05870",
          "borderColor": "#b05870"
        }
      }
    },
    "carousel": {
      "shape": "Path",
      "borderColor": "#dcc8cc",
      "borderThickness": 1,
      "radius": 4,
      "padding": 2
    },
    "pip": {
      "shape": "Path",
      "fill": "transparent",
      "borderColor": "#dcc8cc",
      "borderThickness": 1,
      "radius": 6.5,
      "corner": "bevel",
      "size": {
        "width": 13,
        "height": 13
      },
      "states": {
        "selected": {
          "fill": "#b05870",
          "borderColor": "#b05870"
        }
      }
    },
    "switch.track": {
      "shape": "Path",
      "fill": "#f0dfe2",
      "borderColor": "#dcc8cc",
      "borderThickness": 1,
      "radius": "pill",
      "padding": 2,
      "size": {
        "width": 34,
        "height": 17
      },
      "states": {
        "disabled": {
          "opacity": 0.5
        }
      }
    },
    "switch.thumb": {
      "shape": "Path",
      "fill": "#dcc8cc",
      "radius": "pill",
      "size": {
        "width": 13,
        "height": 13
      },
      "states": {
        "checked": {
          "fill": "#b05870"
        }
      }
    },
    "carousel.nav": {
      "shape": "Path",
      "fill": "#fff5f7",
      "content": "#dcc8cc",
      "borderColor": "#dcc8cc",
      "borderThickness": 1,
      "radius": "pill",
      "size": {
        "width": 31,
        "height": 31
      },
      "states": {
        "hover": {
          "content": "#b05870",
          "borderColor": "#b05870"
        }
      }
    },
    "titlebar.caption": {
      "shape": "Path",
      "content": "#8a5868",
      "size": {
        "width": 34,
        "height": 34
      },
      "states": {
        "hover": {
          "fill": "#fff5f7"
        }
      }
    },
    "titlebar.close": {
      "shape": "Path",
      "content": "#c03030",
      "size": {
        "width": 34,
        "height": 34
      },
      "states": {
        "hover": {
          "fill": "#c03030",
          "content": "#fff5f7"
        }
      }
    },
    "news-item": {
      "shape": "Path",
      "fill": "#fff5f7",
      "content": "#8a5868",
      "borderColor": "#dcc8cc",
      "borderThickness": 1,
      "padding": [
        0,
        12,
        0,
        12
      ],
      "text": {
        "family": "Crimson Pro",
        "fallback": "serif",
        "weight": 700,
        "style": "normal",
        "size": 16
      },
      "size": {
        "height": 43
      },
      "states": {
        "hover": {
          "borderColor": "#8a5868"
        }
      }
    },
    "setting-row": {
      "shape": "Path",
      "fill": "#fff5f7",
      "content": "#8a5868",
      "borderColor": "#dcc8cc",
      "borderThickness": 1,
      "padding": [
        0,
        13,
        0,
        13
      ],
      "text": {
        "family": "Crimson Pro",
        "fallback": "serif",
        "weight": 700,
        "style": "normal",
        "size": 14,
        "case": "uppercase"
      },
      "size": {
        "height": 43
      },
      "states": {
        "selected": {
          "content": "#b05870",
          "borderColor": "#b05870",
          "borderThickness": 2
        }
      }
    },
    "titlebar": {
      "shape": "Path",
      "fill": "#f0dfe2",
      "borderColor": "#dcc8cc",
      "borderThickness": [
        0,
        0,
        1,
        0
      ],
      "padding": [
        0,
        0,
        0,
        23
      ],
      "size": {
        "height": 34
      }
    },
    "subtabs": {
      "shape": "Path",
      "fill": "#f0dfe2",
      "borderColor": "#dcc8cc",
      "borderThickness": [
        0,
        0,
        1,
        0
      ],
      "size": {
        "height": 34
      }
    },
    "scrollbar.track": {
      "shape": "Path",
      "fill": "#f0dfe2",
      "radius": 4,
      "corner": "bevel",
      "size": {
        "width": 8
      }
    },
    "scrollbar.thumb": {
      "shape": "Path",
      "fill": "#8a5868",
      "radius": 4,
      "corner": "bevel",
      "size": {
        "width": 8
      }
    },
    "progress.track": {
      "shape": "Path",
      "fill": "#f0dfe2",
      "radius": "pill",
      "size": {
        "height": 4
      }
    },
    "progress.indicator": {
      "shape": "Path",
      "fill": "#b05870",
      "radius": "pill",
      "size": {
        "height": 4
      }
    },
    "play-ornament": {
      "shape": "Path"
    },
    "input.label": {
      "shape": "Text",
      "content": "#ab838f",
      "text": {
        "family": "Crimson Pro",
        "fallback": "serif",
        "weight": 700,
        "style": "normal",
        "size": 12
      },
      "leftInset": 10
    },
    "news-item.date": {
      "shape": "Text",
      "content": "#ab838f",
      "text": {
        "size": 13
      }
    },
    "news-item.gem": {
      "shape": "Text"
    },
    "titlebar.wordmark": {
      "shape": "Text",
      "content": "#b05870",
      "text": {
        "family": "Crimson Pro",
        "fallback": "serif",
        "weight": 700,
        "style": "normal",
        "size": 20,
        "case": "uppercase"
      }
    },
    "tab-bar": {
      "shape": "Text",
      "content": "#8a5868"
    },
    "settings.heading": {
      "shape": "Text",
      "content": "#8a5868",
      "text": {
        "family": "Crimson Pro",
        "fallback": "serif",
        "weight": 700,
        "style": "normal",
        "size": 16,
        "case": "uppercase"
      }
    },
    "setting-help.title": {
      "shape": "Text",
      "content": "#2a1018",
      "text": {
        "family": "Crimson Pro",
        "fallback": "serif",
        "weight": 700,
        "style": "normal",
        "size": 16,
        "case": "uppercase"
      }
    },
    "setting-help.body": {
      "shape": "Text",
      "content": "#2a1018",
      "text": {
        "size": 13
      }
    },
    "input.placeholder": {
      "shape": "Text",
      "content": "rgba(138, 88, 104, 0.6)"
    },
    "input.caret": {
      "shape": "Text",
      "content": "#b05870"
    },
    "input.error": {
      "shape": "Text",
      "content": "#c03030",
      "text": {
        "family": "Source Sans 3",
        "fallback": "sans-serif",
        "weight": 400,
        "style": "normal",
        "size": 13
      }
    },
    "play-row": {
      "shape": "Text",
      "content": "#dcc8cc"
    }
  }
}
