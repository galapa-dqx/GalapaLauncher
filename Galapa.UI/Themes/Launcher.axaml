<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Galapa.UI.Controls">
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Galapa.Part.window.FillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Galapa.Part.window.ContentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Galapa.Font.Body}" />
        <Setter Property="FontSize" Value="{DynamicResource Galapa.Type.body.Size}" />
    </Style>
    <Style Selector="UserControl">
        <Setter Property="Foreground" Value="{DynamicResource Galapa.Part.window.ContentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Galapa.Font.Body}" />
        <Setter Property="FontSize" Value="{DynamicResource Galapa.Type.body.Size}" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Galapa.Type.body.ContentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Galapa.Type.body.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Galapa.Type.body.Size}" />
    </Style>
    <Style Selector="controls|ThemedTextBlock.brand, TextBlock.brand">
        <Setter Property="Foreground" Value="{DynamicResource Galapa.Type.brand.ContentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Galapa.Type.brand.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Galapa.Type.brand.Size}" />
        <Setter Property="FontWeight" Value="{DynamicResource Galapa.Type.brand.Weight}" />
        <Setter Property="FontStyle" Value="{DynamicResource Galapa.Type.brand.Style}" />
        <Setter Property="LetterSpacing" Value="{DynamicResource Galapa.Type.brand.LetterSpacing}" />
        <Setter Property="controls:ThemedTextBlock.TextTransform" Value="{DynamicResource Galapa.Type.brand.Transform}" />
    </Style>
    <Style Selector="controls|ThemedTextBlock.navigation, TextBlock.navigation">
        <Setter Property="Foreground" Value="{DynamicResource Galapa.Type.navigation.ContentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Galapa.Type.navigation.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Galapa.Type.navigation.Size}" />
        <Setter Property="FontWeight" Value="{DynamicResource Galapa.Type.navigation.Weight}" />
        <Setter Property="FontStyle" Value="{DynamicResource Galapa.Type.navigation.Style}" />
        <Setter Property="LetterSpacing" Value="{DynamicResource Galapa.Type.navigation.LetterSpacing}" />
        <Setter Property="controls:ThemedTextBlock.TextTransform" Value="{DynamicResource Galapa.Type.navigation.Transform}" />
    </Style>
    <Style Selector="controls|ThemedTextBlock.section, TextBlock.section">
        <Setter Property="Foreground" Value="{DynamicResource Galapa.Type.sectionHeading.ContentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Galapa.Type.sectionHeading.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Galapa.Type.sectionHeading.Size}" />
        <Setter Property="FontWeight" Value="{DynamicResource Galapa.Type.sectionHeading.Weight}" />
        <Setter Property="FontStyle" Value="{DynamicResource Galapa.Type.sectionHeading.Style}" />
        <Setter Property="LetterSpacing" Value="{DynamicResource Galapa.Type.sectionHeading.LetterSpacing}" />
        <Setter Property="controls:ThemedTextBlock.TextTransform" Value="{DynamicResource Galapa.Type.sectionHeading.Transform}" />
    </Style>
    <Style Selector="controls|ThemedTextBlock.field-label, TextBlock.field-label">
        <Setter Property="Foreground" Value="{DynamicResource Galapa.Type.fieldLabel.ContentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Galapa.Type.fieldLabel.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Galapa.Type.fieldLabel.Size}" />
        <Setter Property="FontWeight" Value="{DynamicResource Galapa.Type.fieldLabel.Weight}" />
        <Setter Property="FontStyle" Value="{DynamicResource Galapa.Type.fieldLabel.Style}" />
        <Setter Property="LetterSpacing" Value="{DynamicResource Galapa.Type.fieldLabel.LetterSpacing}" />
        <Setter Property="controls:ThemedTextBlock.TextTransform" Value="{DynamicResource Galapa.Type.fieldLabel.Transform}" />
    </Style>
    <Style Selector="controls|ThemedTextBlock.card-title, TextBlock.card-title">
        <Setter Property="Foreground" Value="{DynamicResource Galapa.Type.cardTitle.ContentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Galapa.Type.cardTitle.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Galapa.Type.cardTitle.Size}" />
        <Setter Property="FontWeight" Value="{DynamicResource Galapa.Type.cardTitle.Weight}" />
        <Setter Property="FontStyle" Value="{DynamicResource Galapa.Type.cardTitle.Style}" />
        <Setter Property="LetterSpacing" Value="{DynamicResource Galapa.Type.cardTitle.LetterSpacing}" />
        <Setter Property="controls:ThemedTextBlock.TextTransform" Value="{DynamicResource Galapa.Type.cardTitle.Transform}" />
    </Style>
    <Style Selector="controls|ThemedTextBlock.setting-value, TextBlock.setting-value">
        <Setter Property="Foreground" Value="{DynamicResource Galapa.Type.settingValue.ContentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Galapa.Type.settingValue.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Galapa.Type.settingValue.Size}" />
        <Setter Property="FontWeight" Value="{DynamicResource Galapa.Type.settingValue.Weight}" />
        <Setter Property="FontStyle" Value="{DynamicResource Galapa.Type.settingValue.Style}" />
        <Setter Property="LetterSpacing" Value="{DynamicResource Galapa.Type.settingValue.LetterSpacing}" />
        <Setter Property="controls:ThemedTextBlock.TextTransform" Value="{DynamicResource Galapa.Type.settingValue.Transform}" />
    </Style>
    <Style Selector="controls|ThemedTextBlock.metadata, TextBlock.metadata">
        <Setter Property="Foreground" Value="{DynamicResource Galapa.Type.metadata.ContentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Galapa.Type.metadata.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Galapa.Type.metadata.Size}" />
        <Setter Property="FontWeight" Value="{DynamicResource Galapa.Type.metadata.Weight}" />
        <Setter Property="FontStyle" Value="{DynamicResource Galapa.Type.metadata.Style}" />
        <Setter Property="LetterSpacing" Value="{DynamicResource Galapa.Type.metadata.LetterSpacing}" />
        <Setter Property="controls:ThemedTextBlock.TextTransform" Value="{DynamicResource Galapa.Type.metadata.Transform}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Galapa.Part.setting-help.body.ContentBrush}" />
    </Style>
</Styles>
